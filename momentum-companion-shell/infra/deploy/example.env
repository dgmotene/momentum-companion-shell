# Copy to .env on the VM and fill in. Never commit the real file.

# --- Hostnames Caddy serves (no scheme) ---
HOST_HOSTNAME=lumina.example.com
COMPANION_HOSTNAME=companion.example.com
BACKEND_HOSTNAME=api-lumina.example.com

# --- The same three as full origins (with scheme) ---
# These are baked into the Next bundles at build time. Changing one means
# rebuilding that image, not just restarting it.
HOST_ORIGIN_PUBLIC=https://lumina.example.com
COMPANION_ORIGIN=https://companion.example.com
BACKEND_ORIGIN=https://api-lumina.example.com

# --- Momentum AI Gateway (BACKEND-ONLY) ---
GATEWAY_BASE_URL=https://riskbifrostent.momentum.co.za/openai
UNIVERSAL_API_KEY=your-team-virtual-key
CHAT_MODEL_URL=bedrock/eu.anthropic.claude-haiku-4-5-20251001-v1:0
EMBEDDING_MODEL_URL=bedrock/amazon.titan-embed-text-v2:0
RAG_MIN_SIMILARITY=0.2

# --- Mock identity claims ---
JWT_ISSUER=https://mock-host.local
JWT_AUDIENCE=companion-backend

# --- Optional translation ---
TRANSLATION_PROVIDER=none
VULAVULA_API_TOKEN=
