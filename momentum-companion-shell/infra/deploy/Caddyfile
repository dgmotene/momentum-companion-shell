# Three hostnames, three origins. Host and companion must stay on separate
# origins or the postMessage allowlisting between them means nothing.
#
# All three serve the existing Cloudflare origin certificate (a wildcard SAN for
# the zone), so there is no ACME step; Cloudflare is the edge.

(origin_tls) {
	tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key
}

{$HOST_HOSTNAME} {
	import origin_tls
	reverse_proxy host:3000
}

{$COMPANION_HOSTNAME} {
	import origin_tls
	reverse_proxy companion:3001
}

{$BACKEND_HOSTNAME} {
	import origin_tls
	reverse_proxy backend:4000
}
