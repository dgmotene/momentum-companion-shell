# --- service ---
RAG_PORT=8080
RAG_LOG_LEVEL=INFO
# Shared secret(s) the calling system sends as X-API-Key. Comma-separated for
# rotation. Leave empty in local dev to disable auth.
RAG_API_KEYS=change-me

# --- postgres (the existing one) ---
RAG_DATABASE_URL=postgresql://user:pass@localhost:5432/myriad

# --- model gateway ---
# openai = any OpenAI-compatible proxy (LiteLLM, Bedrock Access Gateway)
# bedrock = talk to Bedrock directly via boto3
RAG_GATEWAY_KIND=openai
# Momentum AI Gateway (Bifrost). No /v1 suffix.
RAG_GATEWAY_BASE_URL=https://riskbifrostent.momentum.co.za/openai
# Your team's virtual key, sent as x-bf-vk
RAG_GATEWAY_VIRTUAL_KEY=
RAG_GATEWAY_APP_ID=risk-ai-api
RAG_GATEWAY_API_KEY=
RAG_AWS_REGION=eu-west-1

# --- FROZEN after the Sprint 0 spike; changing any of these means re-ingesting ---
RAG_EMBED_MODEL=bedrock/amazon.titan-embed-text-v2:0
RAG_EMBED_DIM=1024
RAG_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.25

# --- generation ---
# Start on a cheap model while testing; budget is 50 USD per team.
RAG_CHAT_MODEL=bedrock/eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Fallback only. The guide prints "Page N" footers that reset per product
# section, and those labels are read directly; this offset is used only for
# pages where no footer label can be found.
RAG_PAGE_OFFSET=1
