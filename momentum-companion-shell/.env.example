# Every environment variable used in this codebase, with placeholder values.
# Only docker compose reads this file (as .env, for variable substitution).
# The npm dev services read real environment variables and fall back to the
# defaults below; export a variable in your shell to override it.
# Never commit a real .env.

# --- Database ------------------------------------------------------------------
DATABASE_URL=postgres://companion:companion@localhost:5432/companion

# --- Momentum AI Gateway (BACKEND-ONLY) -----------------------------------------
# The team's virtual key authenticates every gateway call, sent as the x-bf-vk
# header alongside a fixed x-git: risk-ai-api. It is separate from end-user
# identity and must never be referenced in host/, companion/, or any
# browser-delivered code. Obtain the real value from Momentum; do not commit it.
# Put it in .env for the docker path (compose passes it to the backend), or
# export it in your shell for the npm path.
UNIVERSAL_API_KEY=your-team-virtual-key
GATEWAY_BASE_URL=https://riskbifrostent.momentum.co.za/openai
CHAT_MODEL_URL=bedrock/anthropic.claude-3-haiku-20240307-v1:0
EMBEDDING_MODEL_URL=bedrock/amazon.titan-embed-text-v2:0
# Cosine similarity floor for retrieval. Below it, no chunk is considered
# grounding and the answering model is never called.
RAG_MIN_SIMILARITY=0.2

# --- Mock end-user identity (RS256 JWT) -----------------------------------------
# Generated by `npm run setup` (scripts/generate-keys.mjs). Paths default to
# ./keys/ relative to the repo root; override for Docker mounts etc.
# The host signs with the private key and serves the public key at
# /.well-known/jwks.json; the backend fetches it from HOST_ORIGIN.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=https://mock-host.local
JWT_AUDIENCE=companion-backend
HOST_ORIGIN=http://localhost:3000

# --- Origins / ports ------------------------------------------------------------
# postMessage origin allowlisting on both sides of the iframe boundary.
COMPANION_ALLOWED_ORIGIN=http://localhost:3001
NEXT_PUBLIC_HOST_ORIGIN=http://localhost:3000
NEXT_PUBLIC_COMPANION_ORIGIN=http://localhost:3001
NEXT_PUBLIC_COMPANION_BACKEND_URL=http://localhost:4000
COMPANION_BACKEND_PORT=4000
