# Every environment variable used in this codebase, with placeholder values.
# Copy this file to .env and fill in real values. Never commit your real .env.

# --- Database ------------------------------------------------------------------
DATABASE_URL=postgres://companion:companion@localhost:5432/companion

# --- Momentum AI Gateway (machine-to-machine, BACKEND-ONLY) ---------------------
# OAuth2 client-credentials identifying OUR APPLICATION to the gateway.
# These are completely separate from end-user identity and must never be
# referenced in host/, companion/, or any browser-delivered code.
GATEWAY_OAUTH_CLIENT_ID=placeholder-client-id
GATEWAY_OAUTH_CLIENT_SECRET=placeholder-client-secret
GATEWAY_BASE_URL=https://riskservicesdev.momentum.co.za/ai/api

# --- Mock end-user identity (RS256 JWT) -----------------------------------------
# Generated by `npm run setup` (scripts/generate-keys.mjs). Paths default to
# ./keys/ relative to the repo root; override for Docker mounts etc.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=https://mock-host.local
JWT_AUDIENCE=companion-backend

# --- Origins / ports ------------------------------------------------------------
# postMessage origin allowlisting on both sides of the iframe boundary.
COMPANION_ALLOWED_ORIGIN=http://localhost:3001
NEXT_PUBLIC_HOST_ORIGIN=http://localhost:3000
NEXT_PUBLIC_COMPANION_ORIGIN=http://localhost:3001
NEXT_PUBLIC_COMPANION_BACKEND_URL=http://localhost:4000
COMPANION_BACKEND_PORT=4000
